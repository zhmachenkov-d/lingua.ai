# Copy to .env and fill in (never commit .env).
# Used by the dev container via --env-file (rebuild/reopen after changes).
GH_TOKEN=

# Compose Postgres (db service). Host publish ports are fixed in compose.yaml
# (127.0.0.1:5432/8000/4200) — do not override via env.
POSTGRES_USER=lingua
POSTGRES_PASSWORD=lingua
POSTGRES_DB=lingua

# LLM adapter (DeepSeek OpenAI-compatible). Empty/unset → WS error llm_misconfigured
# on non-blank turns. Models: deepseek-flash (primary), deepseek-v4-pro (escalation).
# Never commit real keys. Compose passes this into the api service.
DEEPSEEK_API_KEY=
