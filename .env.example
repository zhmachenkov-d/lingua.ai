# Copy to .env and fill in (never commit .env). See README → Secrets checklist.
# Used by the dev container via --env-file (rebuild/reopen after changes).
#
# Optional — GitHub CLI / Codespaces only; Compose does not inject this.
GH_TOKEN=

# Required for `docker compose up` (db + api). Host publish ports are fixed in
# compose.yaml (127.0.0.1:5432/8000/4200) — do not override via env.
POSTGRES_USER=lingua
POSTGRES_PASSWORD=lingua
POSTGRES_DB=lingua

# Optional for stack start; required for non-blank WS turns.
# Obtain a key at https://platform.deepseek.com/ (API keys). Empty/unset →
# WS error llm_misconfigured. Models: deepseek-flash (primary),
# deepseek-v4-pro (escalation). Never commit real keys. Compose passes this
# into the api service only (not via env_file on every service).
DEEPSEEK_API_KEY=
